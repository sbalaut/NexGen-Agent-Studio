# NexAgent Studio configuration. Copy to .env (next to this file) and edit.
# Lines are KEY=VALUE; environment variables already set take precedence.

# Where the database, uploads, secrets and training folders live (keep it on persistent disk).
# Relative paths are relative to this folder.
NEXAGENT_DATA_DIR=data

# Address the web app listens on. Keep 127.0.0.1 when users reach it through the JupyterHub proxy
# or an HTTPS reverse proxy; use 0.0.0.0 only on an isolated, approved plant LAN.
NEXAGENT_HOST=127.0.0.1
NEXAGENT_PORT=8600

# The exact address users type in the browser (scheme://host[:port], no path). Used for the
# CSRF/origin check and to decide whether cookies are marked Secure.
#   Behind JupyterHub:  NEXAGENT_ORIGIN=https://jupyterhub.mrpl.local
NEXAGENT_ORIGIN=http://127.0.0.1:8600
# Serve under a URL prefix, e.g. when registered as a JupyterHub service (see docs/INSTALL.md):
# NEXAGENT_BASE_PATH=/services/nexagent
# Serve HTTPS directly (internal certificate from IT), then use https:// in NEXAGENT_ORIGIN:
# NEXAGENT_TLS_CERT=/path/to/server.crt
# NEXAGENT_TLS_KEY=/path/to/server.key
# Set to 1 only when a reverse proxy you control sets X-Forwarded-For.
NEXAGENT_TRUSTED_PROXY=0
# Plain http on a non-loopback address is refused unless you explicitly allow it:
# NEXAGENT_ALLOW_HTTP=1

# Local Ollama and default models — the same ones as the DHDT chatbot (change later in Administration → Models).
# Ollama on the JupyterHub server is an admin-managed service; use the URL your DHDT notebook uses.
NEXAGENT_OLLAMA_URL=http://127.0.0.1:11434
NEXAGENT_GENERATION_MODEL=qwen3-next:80b-a3b-instruct-q4_K_M
NEXAGENT_REVIEW_MODEL=qwen3-next:80b-a3b-instruct-q4_K_M
NEXAGENT_EMBEDDING_MODEL=qwen3-embedding:8b
# Context window sent to Ollama (its own default is small and would cut off the sources).
NEXAGENT_NUM_CTX=16384
# Keep models loaded between questions (avoids reloading the 80B model every time).
NEXAGENT_KEEP_ALIVE=30m
# Hosts model connections may use (comma-separated). Add your GPU server's name if Ollama runs elsewhere.
NEXAGENT_ALLOWED_MODEL_HOSTS=127.0.0.1,localhost,::1
NEXAGENT_LLM_TIMEOUT_S=600

# Background worker threads for indexing and questions.
NEXAGENT_WORKERS=2
NEXAGENT_MAX_UPLOAD_MB=40
NEXAGENT_SESSION_HOURS=8

# Fine-tuning (optional): python of the separate training venv, approved base-model folder,
# GPU(s) reserved for training, and a hard time limit per job.
NEXAGENT_TRAIN_PYTHON=
NEXAGENT_MODELS_DIR=data/base-models
NEXAGENT_TRAIN_GPU=
NEXAGENT_TRAIN_MAX_HOURS=12
NEXAGENT_OLLAMA_CLI=ollama

# ------------------------------------------------------------------ public server (v0.3)
# Public mode: open sign-up, every user brings their own OpenAI / Anthropic / Gemini API key, each user gets a
# private workspace, answer-review queue and fine-tuning are hidden, local-command (stdio) MCP servers are off.
# NEXAGENT_PUBLIC_MODE=1
# Sign-up is on by default in public mode; set 0 to create accounts only as an administrator.
# NEXAGENT_ALLOW_SIGNUP=1
# Features shown (comma-separated): review, training, mcp, agents, graphrag
# NEXAGENT_FEATURES=mcp,agents,graphrag
# Per-user limits in public mode
# NEXAGENT_QUOTA_RUNS_PER_HOUR=60
# NEXAGENT_QUOTA_DOCS_PER_USER=100
# NEXAGENT_QUOTA_UPLOAD_MB_PER_USER=500
# NEXAGENT_SIGNUPS_PER_IP_PER_DAY=5
# Local-command MCP servers (admin only). Default: on for plant servers, off in public mode.
# NEXAGENT_ALLOW_STDIO_MCP=0
# First administrator on hosts without a console (created once at start-up; remove the password afterwards).
# NEXAGENT_BOOTSTRAP_ADMIN=owner
# NEXAGENT_BOOTSTRAP_ADMIN_PASSWORD=

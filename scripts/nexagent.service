# systemd *user* unit (no root needed):
#   mkdir -p ~/.config/systemd/user && cp scripts/nexagent.service ~/.config/systemd/user/
#   edit WorkingDirectory/ExecStart paths, then: systemctl --user daemon-reload && systemctl --user enable --now nexagent
#   loginctl enable-linger $USER   (ask IT if this is not permitted; otherwise use scripts/run.sh)
[Unit]
Description=NexAgent Studio
After=network.target

[Service]
WorkingDirectory=%h/nexagent-studio/backend
EnvironmentFile=%h/nexagent-studio/.env
ExecStart=%h/nexagent-studio/venv/bin/python -m nexagent.cli serve
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=default.target
